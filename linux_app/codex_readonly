#!/bin/sh
# 只允许额度查询所需的 app-server，运行时数据留在临时挂载中
set -eu
# 宿主程序使用系统库，不能继承 PyInstaller 的私有动态库目录
if [ "${BAILONG_FROZEN:-0}" = 1 ]; then
    if [ "${LD_LIBRARY_PATH_ORIG+x}" = x ]; then
        export LD_LIBRARY_PATH="$LD_LIBRARY_PATH_ORIG"
    else
        unset LD_LIBRARY_PATH
    fi
fi
if [ "$#" -ne 1 ] || [ "$1" != 'app-server' ]; then
    echo 'Only app-server is supported' >&2
    exit 2
fi
: "${CODEX_HOME:?CODEX_HOME is required}"
: "${BAILONG_NATIVE_CODEX:?BAILONG_NATIVE_CODEX is required}"
set -- -- "$BAILONG_NATIVE_CODEX" -c 'cli_auth_credentials_store="file"' app-server
for name in config.toml auth.json; do
    if [ -f "$CODEX_HOME/$name" ]; then
        set -- --ro-bind "$CODEX_HOME/$name" "$CODEX_HOME/$name" "$@"
    fi
done
exec bwrap --die-with-parent --ro-bind / / --dev-bind /dev /dev --proc /proc \
    --tmpfs /tmp --tmpfs "$CODEX_HOME" "$@"
